# Disable directory listing
Options -Indexes

# Prevent access to hidden files and directories (like .git, .env)
RedirectMatch 404 /\..*$

# Prevent direct web access to database schemas, configs, and package files
<FilesMatch "\.(sql|env|log|md|lock)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(package|package-lock|tsconfig|vite\.config)\.">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME Sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Cross-Site Scripting Filter Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Set default index
DirectoryIndex index.html
